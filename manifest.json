{
  "manifest_version": 3,
  "name": "OKStudy",
  "version": "2.0.2",
  "minimum_chrome_version": "116",
  "description": "Zaznacz zadanie. Zrozum rozwiązanie. Gemini, Claude, OpenAI i Grok, podpowiedzi, historia oraz opcjonalne konto ChatGPT.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "contextMenus",
    "nativeMessaging",
    "offscreen"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://api.x.ai/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "OKStudy",
    "default_popup": "popup.html"
  },
  "side_panel": { "default_path": "panel.html" },
  "commands": {
    "solve_fast": {
      "suggested_key": {
        "default": "Alt+O",
        "mac": "Alt+O"
      },
      "description": "Szybka analiza (bez internetu)"
    },
    "solve_internet": {
      "suggested_key": {
        "default": "Alt+I",
        "mac": "Alt+I"
      },
      "description": "Dokładna analiza (z internetem)"
    },
    "repeat_last": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "Powtórz ostatnią odpowiedź"
    },
    "cancel": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K"
      },
      "description": "Przerwij / kasuj bieżącą analizę"
    },
    "toggle_model": {
      "description": "Przełącz model u aktywnego dostawcy"
    },
    "solve_alt": {
      "description": "Zaznacz fragment ekranu do analizy"
    }
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
